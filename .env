# Application
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-use-secret-manager
DEBUG=true
LOG_LEVEL=DEBUG

# Google Cloud
GCP_PROJECT_ID=porygon-pipelines
GCP_LOCATION=us-east4
GCP_SERVICE_ACCOUNT_EMAIL=tech-coach@your-project.iam.gserviceaccount.com

# Vertex AI
VERTEX_AI_MODEL_ID=gemini-1.5-pro-002
VERTEX_AI_EMBEDDING_MODEL_ID=text-embedding-004
VERTEX_AI_LOCATION=us-central1

# Database (Cloud SQL / local PostgreSQL)
# Production: use Secret Manager, not env vars
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tech_coach
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis Cache
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL_SECONDS=86400

# Auth (Google OAuth)
# Production: these come from Secret Manager
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
ALLOWED_USER_EMAIL=anamargaritapreciado@gmail.com

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Evaluation
EVAL_BASELINE_PROMPT_VERSION=coaching_dialogue:1.0.0
EVAL_PASS_THRESHOLD=0.85

# Cost Tracking
# Prices in USD per 1k tokens (update when Vertex AI pricing changes)
GEMINI_PRO_INPUT_PRICE_PER_1K=0.00125
GEMINI_PRO_OUTPUT_PRICE_PER_1K=0.005
GEMINI_FLASH_INPUT_PRICE_PER_1K=0.000075
GEMINI_FLASH_OUTPUT_PRICE_PER_1K=0.0003

# Frontend
BACKEND_URL=http://localhost:8000
STREAMLIT_SERVER_PORT=8501
